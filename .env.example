# ============ HowlForge environment ============
# Copy to `.env` and fill in. Never commit `.env`.

# ---- Language ----
# `pl` or `en`. Controls AI note content and UI/CLI language.
# Controlled vocabulary keys (status, category...) stay in English for consistency.
HOWLFORGE_LANGUAGE=pl

# ---- Vault ----
# Where the Markdown vault lives (relative to repo root or absolute).
HOWLFORGE_VAULT_PATH=./vault

# ---- Panel auth ----
# If set, the web panel + API require this password (cookie session). Leave empty
# for an open, unauthenticated panel (local use only).
HOWLFORGE_PANEL_PASSWORD=

# ---- Telegram (phase 2) ----
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ---- AI (LiteLLM) ----
# Default model key from howlforge/llm_config.yaml. Override at runtime.
HOWLFORGE_LLM_MODEL=howl-classify

# Provider API keys. Set only the ones you use.
# NVIDIA NIM (free tier) - default cheap/free path.
NVIDIA_API_KEY=
# Anthropic Claude
ANTHROPIC_API_KEY=
# Google Gemini
GEMINI_API_KEY=
# OpenAI / GPT
OPENAI_API_KEY=
# DeepSeek
DEEPSEEK_API_KEY=
# OpenRouter (many models in one key)
OPENROUTER_API_KEY=

# ---- LiteLLM config ----
# Optional path to a custom model list (defaults to howlforge/llm_config.yaml)
HOWLFORGE_LLM_CONFIG=./howlforge/llm_config.yaml
